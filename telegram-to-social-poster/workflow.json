    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 1. Filter: Cari produk yang kolom Status-nya kosong ATAU berisi kata \"Belum\"\nconst unpostedItems = items.filter(item => {\n    const status = item.json.status_threads;\n    \n    // Kalau kolomnya benar-benar kosong (undefined/null) dari GSheet\n    if (!status) return true; \n    \n    // Ubah jadi string biar aman di-trim, cek apakah kosong atau berisi \"belum\"\n    const statusText = String(status).trim().toLowerCase();\n    return statusText === \"\" || statusText === \"belum\";\n});\n\n// 2. Cek: Kalau semua barang udah laku/terposting\nif (unpostedItems.length === 0) {\n    return []; \n}\n\n// 3. Pick 1: Ambil produk urutan pertama \nconst selectedItem = unpostedItems[0];\n\n// 4. Return\nreturn [selectedItem];"
      },
