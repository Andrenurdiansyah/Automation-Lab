      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 1. Cek: Kalau data kosong/nggak ada barang sama sekali\nif (items.length === 0) {\n    return []; \n}\n\n// 2. Pick 1 Random: Ambil index acak dari 0 sampai (jumlah item - 1)\nconst randomIndex = Math.floor(Math.random() * items.length);\nconst selectedItem = items[randomIndex];\n\n// 3. Return\nreturn [selectedItem];"
      },
