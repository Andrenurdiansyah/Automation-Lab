      "parameters": {
        "jsCode": "// Ambil output teks dari AI (struktur response Groq/OpenAI)\nconst aiText = $input.first().json.choices[0].message.content;\n\n// Bersihkan markdown atau backtick yang sering nyelip dari AI\nconst cleanText = aiText.replace(/```json/g, '').replace(/```/g, '').trim();\n\n// Ubah string JSON jadi Object n8n\nconst parsedData = JSON.parse(cleanText);\n\n// Kembalikan sebagai item n8n\nreturn [\n    {\n        json: parsedData\n    }\n];"
